[sub_resource type="GDScript" id="GDScript_rxg2q"]
script/source = "extends Node2D

#NOTE no support for masks or \"appended jsons\" (for pico) is implemented yet, 
#but if it was masks were implemented u would have to manually target the mask field
#on update whenever the frame changes. 
#I.e for the drop shadow shader it would have to target the alt mask field
#not too sure how if implementing that would effect performance
#said update would have to be in an \"extends Blit_Sprite2D\"


# example of what converting a resource looks like, id make a ui extension for this but i dunno how :/
#func convert_resources() -> void:
	##the second path for this is not really needed if the intended location is the same as the XML
	##do note that it DOES need the extension though, or rather any extension as it will 
	##automatically replace that with json if isn't already
	#Blit_Sprite2D.BLIT_RES.convert_XML(\"res://Examples/GF_assets.xml\",\"res://Examples/gf.json\")
	#
	##This takes in one of the offset JSONS from FNF V-slice appends them and spits out the file
	#Blit_Sprite2D.BLIT_RES.append_offsets(\"res://Examples/gf.json\",\"res://Examples/gf_offsets.json\")
#
#func _ready() -> void:
	#convert_resources()



# example for what playing animations could look like
func _unhandled_input(_event: InputEvent) -> void:
	for blit_SPR:Blit_Sprite2D in $Node2D.get_children():
		if Input.is_action_just_pressed(\"ui_accept\"):
			#play abstract follows the logic of there being multiple entries
			blit_SPR.play_abstract(\"idle\",1.0)
		
		
		if Input.is_action_just_pressed(\"ui_right\"):
			#so choosing RIGHT, chooses from right and right miss
			#0 being normal and 1 being miss
			blit_SPR.play_abstract(\"RIGHT\",1.0,0)
		
		if Input.is_action_just_pressed(\"ui_left\"):
			blit_SPR.play_abstract(\"LEFT\",1.0,0)
		
		if Input.is_action_just_pressed(\"ui_up\"):
			blit_SPR.play_abstract(\"UP\",1.0,0)
		
		if Input.is_action_just_pressed(\"ui_down\"):
			blit_SPR.play_abstract(\"DOWN\",1.0,0)
"

